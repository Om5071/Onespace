# ==========================================
# OneSpace Backend Environment Template (.env.example)
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas SRV or Local MongoDB)
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<dbname>?retryWrites=true&w=majority&appName=<appname>
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/onespace?retryWrites=true&w=majority

# Authentication Secrets (Generate strong random 64-char strings for production)
JWT_SECRET=your_jwt_secret_key_here_min_32_characters_long
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_key_here_min_32_characters_long
REFRESH_TOKEN_EXPIRES_IN=30d

# Frontend Origin for CORS
FRONTEND_URL=http://localhost:5173

# Web Push Notifications (VAPID Keys)
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_EMAIL=mailto:support@onespace.app

# ==========================================
# OneSpace Frontend Environment Configuration
# ==========================================

# Base API URL
# In development with Vite proxy, '/api' routes to backend server (http://localhost:5000/api)
VITE_API_URL=/api

# Application Metadata
VITE_APP_NAME=OneSpace
VITE_APP_DESCRIPTION=Modern All-In-One Personal Management & Productivity Platform
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_PUSH_NOTIFICATIONS=true
VITE_ENABLE_SOUNDS=true

# ==========================================
# OneSpace Frontend Environment Template (.env.example)
# ==========================================

# API Base URL
# - Development: /api (proxied to http://localhost:5000/api by Vite)
# - Direct: http://localhost:5000/api
# - Production: https://api.yourdomain.com/api
VITE_API_URL=/api

# Application Metadata
VITE_APP_NAME=OneSpace
VITE_APP_DESCRIPTION=Modern All-In-One Personal Management & Productivity Platform
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_PUSH_NOTIFICATIONS=true
VITE_ENABLE_SOUNDS=true

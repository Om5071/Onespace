# ==========================================
# OneSpace Frontend Production Environment (.env.production)
# ==========================================

# Production API Endpoint (Update with your deployed backend domain, e.g. https://api.onespace.app/api or /api if behind reverse proxy)
VITE_API_URL=/api

# Application Metadata
VITE_APP_NAME=OneSpace
VITE_APP_DESCRIPTION=Modern All-In-One Personal Management & Productivity Platform
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_PUSH_NOTIFICATIONS=true
VITE_ENABLE_SOUNDS=true

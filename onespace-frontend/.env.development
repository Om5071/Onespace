# ==========================================
# OneSpace Frontend Development Environment (.env.development)
# ==========================================

# Backend API Endpoint (proxied via Vite dev server or direct localhost)
VITE_API_URL=/api

# App Settings
VITE_APP_NAME=OneSpace (Dev)
VITE_APP_DESCRIPTION=Modern All-In-One Personal Management & Productivity Platform
VITE_APP_VERSION=1.0.0-dev

# Feature Flags
VITE_ENABLE_PUSH_NOTIFICATIONS=true
VITE_ENABLE_SOUNDS=true
